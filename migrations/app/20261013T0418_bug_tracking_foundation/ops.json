    "id": "table.bug_report",
    "label": "Create table \"bug_report\"",
    "summary": "Creates table \"bug_report\"",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "table",
        "name": "bug_report"
      }
    },
    "precheck": [
      {
        "description": "ensure table \"bug_report\" does not exist",
        "sql": "SELECT (to_regclass($1)) IS NULL AS \"result\"",
        "params": [
          "\"public\".\"bug_report\""
        ]
      }
    ],
    "execute": [
      {
        "description": "create table \"bug_report\"",
        "sql": "CREATE TABLE \"public\".\"bug_report\" (\n  \"actualBehavior\" text NOT NULL,\n  \"appVersion\" text,\n  \"browser\" text,\n  \"component\" text NOT NULL,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"description\" text,\n  \"device\" text,\n  \"discoveredAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"discoverySource\" text NOT NULL,\n  \"environment\" text NOT NULL,\n  \"expectedBehavior\" text NOT NULL,\n  \"id\" uuid NOT NULL,\n  \"os\" text,\n  \"projectId\" uuid NOT NULL,\n  \"reporterId\" text NOT NULL,\n  \"reproductionSteps\" text[] NOT NULL,\n  \"route\" text NOT NULL,\n  \"severity\" text NOT NULL,\n  \"status\" text DEFAULT 'reported' NOT NULL,\n  \"taskId\" uuid NOT NULL,\n  \"updatedAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"version\" int4 DEFAULT 1 NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"bug_report_discoverySource_check_3697728e\" CHECK (\"discoverySource\" IN ('internal_qa', 'customer_report', 'support', 'automated_test', 'monitoring', 'employee_report')),\n  CONSTRAINT \"bug_report_environment_check_d2a5394b\" CHECK (\"environment\" IN ('production', 'staging', 'development', 'test', 'other')),\n  CONSTRAINT \"bug_report_reproductionSteps_elem_not_null_5718606e\" CHECK (array_position(\"reproductionSteps\", NULL) IS NULL),\n  CONSTRAINT \"bug_report_severity_check_be538c8d\" CHECK (\"severity\" IN ('blocker', 'critical', 'major', 'minor', 'trivial')),\n  CONSTRAINT \"bug_report_status_check_c394d412\" CHECK (\"status\" IN ('reported', 'triaged', 'in_progress', 'in_verification', 'awaiting_admin_approval', 'approved_for_release', 'released', 'closed', 'duplicate', 'rejected'))\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"bug_report\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
        "params": [
          "\"public\".\"bug_report\""
        ]
      }
    ]
  },
