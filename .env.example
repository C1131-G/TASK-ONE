# Copy to .env for local development. These credentials are only for the local
# Docker database; use managed secrets for any shared or production database.
POSTGRES_PORT=5433
POSTGRES_USER=taskora
POSTGRES_PASSWORD=local-dev-password
POSTGRES_DB=taskora
DATABASE_URL="postgresql://taskora:local-dev-password@localhost:5433/taskora?sslmode=disable"
DATABASE_URL_DOCKER="postgresql://taskora:local-dev-password@postgres:5432/taskora?sslmode=disable"
TEST_DATABASE_URL="postgresql://taskora:local-dev-password@localhost:5433/taskora_test?sslmode=disable"
# Generate a unique secret with `openssl rand -base64 32` (at least 32 characters).
BETTER_AUTH_SECRET="paste-a-unique-random-secret-of-at-least-32-characters"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"
# Header your reverse proxy sets to the client address. Rate limits and the
# audit trail read only this header. Defaults to x-forwarded-for, where the
# entry TRUSTED_PROXY_HOPS places from the right is used (default 1: the
# address your one proxy appended). Prefer a header the proxy overwrites,
# such as "x-real-ip" or "cf-connecting-ip".
TRUSTED_IP_HEADER="x-forwarded-for"
TRUSTED_PROXY_HOPS=1
SCHEDULER_TOKEN="replace-with-a-random-value-of-at-least-32-characters"
# Optional. Shared HMAC secret for POST /api/intake/email (inbound email
# intake). Leave unset to switch email intake off.
# INTAKE_EMAIL_SECRET="replace-with-a-random-value-of-at-least-32-characters"
DATABASE_POOL_MAX=10
APP_PORT=3000
# Replace with a stable base64-encoded 32-byte key shared by all app instances.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="

# Private S3-compatible object storage. MinIO is suitable for local development.
S3_ENDPOINT="http://localhost:9000"
S3_ENDPOINT_DOCKER="http://minio:9000"
S3_PUBLIC_ENDPOINT="http://localhost:9000"
S3_BROWSER_ORIGIN="http://localhost:3000"
S3_REGION="us-east-1"
S3_BUCKET="taskora-private"
# Local MinIO credentials must match MINIO_ROOT_USER and MINIO_ROOT_PASSWORD.
S3_ACCESS_KEY_ID="taskora"
S3_SECRET_ACCESS_KEY="local-minio-password"
MINIO_ROOT_USER="taskora"
MINIO_ROOT_PASSWORD="local-minio-password"
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Optional browser push delivery.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.test"
WEB_PUSH_ALLOWED_HOSTS="fcm.googleapis.com,push.services.mozilla.com,web.push.apple.com"

# Optional email notifications. Leave SMTP_HOST empty to only log emails.
# SMTP_HOST and EMAIL_FROM go together; so do SMTP_USER and SMTP_PASSWORD.
# Links in emails use BETTER_AUTH_URL.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM=""

# Outgoing webhooks. Signing secrets are stored encrypted under a key derived
# from WEBHOOK_ENCRYPTION_KEY, or from BETTER_AUTH_SECRET when this is unset.
# Set a dedicated value (32+ characters) so rotating the auth secret does not
# strand existing webhook secrets. Delivery logs are kept 30 days by default.
WEBHOOK_ENCRYPTION_KEY=""
RETENTION_WEBHOOK_DELIVERY_DAYS=30
RETENTION_AUTOMATION_RUN_DAYS=30
# Sent-email receipts (they stop a duplicate send) are kept 90 days by default.
RETENTION_EMAIL_DELIVERY_DAYS=90
