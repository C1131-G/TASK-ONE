// use prisma-8

// An admin-defined "when <trigger> if <conditions> then <actions>" rule for one
// project. Conditions and actions are validated against the typed rule schema
// on save; the columns hold only that validated shape.
model AutomationRule {
  id          Uuid @id @default(uuid())
  projectId   Uuid
  name        String
  trigger     String
  conditions  Json
  actions     Json
  enabled     Boolean @default(true)
  createdById String
  createdAt   TimestamptzJsDate @default(now())
  updatedAt   TimestamptzJsDate @default(now())
  version     Int @default(1)

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User @relation("AutomationRuleCreator", fields: [createdById], references: [id], onDelete: Restrict)
  runs      AutomationRun[]

  @@index([projectId, enabled, trigger])
  @@index([createdById])
  @@map("automation_rule")
}
