// use prisma-8

model Job {
  id Uuid @id @default(uuid())
  kind String
  payload Json
  dedupeKey String @unique
  availableAt TimestamptzJsDate @default(now())
  attempts Int @default(0)
  maxAttempts Int @default(8)
  leasedUntil TimestamptzJsDate?
  leaseOwner String?
  leaseToken Uuid?
  lastError String?
  completedAt TimestamptzJsDate?
  deadAt TimestamptzJsDate?
  createdAt TimestamptzJsDate @default(now())
  updatedAt TimestamptzJsDate @default(now())

  // Only pending work is claimed; finished and dead rows stay out of the index.
  @@index([availableAt, leasedUntil], where: "\"completedAt\" IS NULL AND \"deadAt\" IS NULL", name: "job_claimable")
  // Retention purges and the dead-job list scan these, never the pending rows.
  @@index([completedAt], where: "\"completedAt\" IS NOT NULL", name: "job_completed")
  @@index([deadAt], where: "\"deadAt\" IS NOT NULL", name: "job_dead")
  @@index([leaseOwner, leasedUntil])
  @@map("job")
}
