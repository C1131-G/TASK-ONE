# Copy to .env for local development. These credentials are only for the local
# Docker database; use managed secrets for any shared or production database.
POSTGRES_PORT=5433
POSTGRES_USER=metsys
POSTGRES_PASSWORD=local-dev-password
POSTGRES_DB=metsys
DATABASE_URL="postgresql://metsys:local-dev-password@localhost:5433/metsys?sslmode=disable"
DATABASE_URL_DOCKER="postgresql://metsys:local-dev-password@postgres:5432/metsys?sslmode=disable"
TEST_DATABASE_URL="postgresql://metsys:local-dev-password@localhost:5433/metsys_test?sslmode=disable"
# Generate a unique secret with `openssl rand -base64 32` (at least 32 characters).
BETTER_AUTH_SECRET="paste-a-unique-random-secret-of-at-least-32-characters"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"
SCHEDULER_TOKEN="replace-with-a-random-value-of-at-least-32-characters"
DATABASE_POOL_MAX=10
APP_PORT=3000
# Replace with a stable base64-encoded 32-byte key shared by all app instances.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="

# Private S3-compatible object storage. MinIO is suitable for local development.
S3_ENDPOINT="http://localhost:9000"
S3_ENDPOINT_DOCKER="http://minio:9000"
S3_PUBLIC_ENDPOINT="http://localhost:9000"
S3_BROWSER_ORIGIN="http://localhost:3000"
S3_REGION="us-east-1"
S3_BUCKET="metsys-private"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
MINIO_ROOT_USER="metsys"
MINIO_ROOT_PASSWORD="local-minio-password"
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Optional browser push delivery.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.test"
WEB_PUSH_ALLOWED_HOSTS="fcm.googleapis.com,push.services.mozilla.com,web.push.apple.com"
