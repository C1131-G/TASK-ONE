// use prisma-8

model ClientCompanyProject {
  id        Uuid @id @default(uuid())
  companyId Uuid
  projectId Uuid
  addedAt   TimestamptzJsDate @default(now())
  removedAt TimestamptzJsDate?

  company ClientCompany @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([companyId, projectId])
  @@index([projectId])
  @@map("client_company_project")
}
