      }
    ],
    "execute": [
      {
        "description": "create table \"approval_request\"",
        "sql": "CREATE TABLE \"public\".\"approval_request\" (\n  \"cancelledAt\" timestamptz,\n  \"cancelledById\" text,\n  \"companyId\" uuid NOT NULL,\n  \"decidedAt\" timestamptz,\n  \"decidedById\" text,\n  \"decisionComment\" text,\n  \"id\" uuid NOT NULL,\n  \"message\" text NOT NULL,\n  \"milestoneId\" uuid,\n  \"projectId\" uuid NOT NULL,\n  \"requestedAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"requestedById\" text NOT NULL,\n  \"status\" text DEFAULT 'pending' NOT NULL,\n  \"subjectKey\" text NOT NULL,\n  \"subjectTitle\" text NOT NULL,\n  \"taskId\" uuid,\n  \"version\" int4 NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"approval_request_one_subject_75cd91e2\" CHECK ((\"taskId\" IS NOT NULL) <> (\"milestoneId\" IS NOT NULL)),\n  CONSTRAINT \"approval_request_status_valid_a989b6ba\" CHECK ((\"status\" = 'pending' AND \"decidedById\" IS NULL AND \"decidedAt\" IS NULL AND \"decisionComment\" IS NULL AND \"cancelledAt\" IS NULL) OR (\"status\" = 'approved' AND \"decidedById\" IS NOT NULL AND \"decidedAt\" IS NOT NULL AND \"cancelledAt\" IS NULL) OR (\"status\" = 'changes_requested' AND \"decidedById\" IS NOT NULL AND \"decidedAt\" IS NOT NULL AND length(trim(\"decisionComment\")) > 0 AND \"cancelledAt\" IS NULL) OR (\"status\" = 'cancelled' AND \"decidedById\" IS NULL AND \"decidedAt\" IS NULL AND \"cancelledById\" IS NOT NULL AND \"cancelledAt\" IS NOT NULL)),\n  CONSTRAINT \"approval_request_version_positive_efca705d\" CHECK (\"version\" > 0)\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"approval_request\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
        "params": [
          "\"public\".\"approval_request\""
        ]
      }
    ]
  },
