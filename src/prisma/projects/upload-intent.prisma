// use prisma-8

model UploadIntent {
  id Uuid @id @default(uuid())
  ownerId String
  taskId Uuid?
  projectId Uuid?
  objectKey String @unique
  fileName String
  contentType String
  sizeBytes BigInt
  state String @default("pending")
  expiresAt TimestamptzJsDate
  finalizedAt TimestamptzJsDate?
  removedAt TimestamptzJsDate?
  createdAt TimestamptzJsDate @default(now())
  updatedAt TimestamptzJsDate @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  task Task? @relation(fields: [taskId], references: [id], onDelete: Restrict)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@check(expression: "\"sizeBytes\" > 0 AND \"sizeBytes\" <= 52428800", name: "upload_size_valid")
  @@check(expression: "state IN ('pending', 'finalized', 'failed', 'removed')", name: "upload_state_valid")
  @@index([ownerId, state, createdAt])
  @@index([taskId, state])
  @@index([projectId, state])
  @@index([expiresAt, state])
  @@map("upload_intent")
}
