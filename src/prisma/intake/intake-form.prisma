// use prisma-8

// A public intake form for one client company's project. The slug is the
// unguessable capability in the public URL; rotating it retires the old link.
model IntakeForm {
  id              Uuid @id @default(uuid())
  slug            String @unique
  name            String
  clientCompanyId Uuid
  projectId       Uuid
  enabled         Boolean @default(true)
  createdById     String
  createdAt       TimestamptzJsDate @default(now())
  updatedAt       TimestamptzJsDate @default(now())
  version         Int @default(1)

  clientCompany ClientCompany @relation(fields: [clientCompanyId], references: [id], onDelete: Restrict)
  project       Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createdBy     User @relation("IntakeFormCreator", fields: [createdById], references: [id], onDelete: Restrict)
  submissions   IntakeSubmission[]

  @@index([clientCompanyId])
  @@index([projectId])
  @@index([createdById])
  @@map("intake_form")
}
